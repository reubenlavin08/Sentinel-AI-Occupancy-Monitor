# Database (generated at runtime)
occupancy_log.db
occupancy_log_*.db
*.db-wal
*.db-shm

# Event media (generated at runtime)
clips/
snapshots/

# Virtual environment
.venv/

# Claude Code config
.claude/

# Python cache
__pycache__/
*.pyc
*.pyo

# Environment / secrets
.env

# ── NVR (Frigate) operational data — LOCAL ONLY, never commit ──
# Real camera config (has LAN IPs); a sanitized config.example.yml is committed instead
nvr/config/config.yml
# Frigate runtime databases, secrets, caches
nvr/config/*.db
nvr/config/*.db-shm
nvr/config/*.db-wal
nvr/config/.jwt_secret
nvr/config/go2rtc_homekit.yml
nvr/config/backup*
nvr/config/.exports/
nvr/config/.timeline/
nvr/config/.vacuum/
nvr/config/model_cache/
# Recorded footage / clips / snapshots (real surveillance data)
nvr/storage/
